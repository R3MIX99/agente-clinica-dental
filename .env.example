# ============================================================
# Variables de entorno — Agente IA para Clínica Dental
# Copia este archivo como .env.local en /dashboard y completa
# los valores. NUNCA versiones el archivo con valores reales.
# ============================================================

# Supabase (servidor — solo en n8n y server actions/route handlers)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard Next.js (públicas, seguras para el navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# n8n / Mensajería
TELEGRAM_BOT_TOKEN=            # Token del bot de Telegram (BotFather)
N8N_OUTBOUND_WEBHOOK_URL=      # URL del webhook de n8n para que el dashboard envíe mensajes (Workflow 3)
N8N_SHARED_SECRET=             # Secreto compartido para validar llamadas dashboard <-> n8n

# IA
ANTHROPIC_API_KEY=             # Clave de API de Anthropic (Claude)

# WhatsApp (preparado, no usado aún)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
