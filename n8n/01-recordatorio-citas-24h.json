      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 300],
      "credentials": {
        "supabaseApi": {
          "id": "cred-supabase",
          "name": "Supabase — Clinica Dental"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://vbsoujyosifqtazcidul.supabase.co/rest/v1/uso_metering",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Accept", "value": "application/json" }]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "select", "value": "clinica_id,cantidad" },
            { "name": "tipo", "value": "eq.recordatorio" },
            { "name": "created_at", "value": "gte.{{ new Date(new Date().getFullYear(), new Date().getMonth(), 1).toISOString() }}" }
          ]
        }
      },
      "id": "node-obtener-uso",
      "name": "Obtener uso recordatorios mes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 300],
      "credentials": {
        "supabaseApi": {
          "id": "cred-supabase",
          "name": "Supabase — Clinica Dental"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Normalizar arrays\nfunction arr(v) { return Array.isArray(v) ? v : (v && typeof v === 'object' ? [v] : []); }\n\nconst clinicas     = arr($('Obtener clinicas activas').first().json);\nconst canales      = arr($('Obtener canales telegram activos').first().json);\nconst suscripciones = arr($('Obtener suscripciones activas').first().json);\nconst citas        = arr($('Obtener citas sin recordatorio').first().json);\nconst usoMes       = arr($('Obtener uso recordatorios mes').first().json);\n\n// Mapas de lookup\nconst clinicaPorId    = new Map(clinicas.map(c => [c.id, c]));\nconst canalPorClinica = new Map(canales.map(c => [c.clinica_id, c]));\n\n// Primera suscripcion activa por cuenta\nconst suscPorCuenta = new Map();\nfor (const s of suscripciones) {\n  if (!suscPorCuenta.has(s.cuenta_id)) suscPorCuenta.set(s.cuenta_id, s);\n}\n\n// Recordatorios ya enviados este mes por clinica\nconst usoPorClinica = new Map();\nfor (const u of usoMes) {\n  usoPorClinica.set(u.clinica_id, (usoPorClinica.get(u.clinica_id) || 0) + 1);\n}\n\n// Ventana 23-25 horas desde ahora\nconst ahora = Date.now();\nconst min   = ahora + 23 * 3600000;\nconst max   = ahora + 25 * 3600000;\n\nconst resultados = [];\n\nfor (const cita of citas) {\n  const clinica = clinicaPorId.get(cita.clinica_id);\n  if (!clinica) continue;\n\n  // Solo clinicas con canal telegram activo y token configurado\n  const canal = canalPorClinica.get(cita.clinica_id);\n  if (!canal || !canal.config?.bot_token) continue;\n\n  // Verificar ventana temporal\n  const iso = (cita.fecha_hora || '').replace(' ', 'T').replace(/\\+(\\d{2})$/, '+$1:00');\n  const t = new Date(iso).getTime();\n  if (isNaN(t) || t < min || t > max) continue;\n\n  // Verificar limite de recordatorios del plan\n  const susc = suscPorCuenta.get(clinica.cuenta_id);\n  const maxRec = susc?.planes?.max_recordatorios_mes ?? 9999;\n  const usados = usoPorClinica.get(cita.clinica_id) || 0;\n  if (usados >= maxRec) continue;\n\n  // Incrementar contador local (evita enviar mas de lo permitido en esta ejecucion)\n  usoPorClinica.set(cita.clinica_id, usados + 1);\n\n  const paciente  = cita.patients;\n  const servicio  = cita.services;\n  const fecha     = new Date(iso);\n  const opsFecha  = { timeZone: 'America/Mexico_City', weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };\n  const opsHora   = { timeZone: 'America/Mexico_City', hour: '2-digit', minute: '2-digit', hour12: true };\n  const fechaTxt  = fecha.toLocaleDateString('es-MX', opsFecha);\n  const horaTxt   = fecha.toLocaleTimeString('es-MX', opsHora);\n  const costoTxt  = cita.costo ? `$${Number(cita.costo).toLocaleString('es-MX', { minimumFractionDigits: 2 })} MXN` : 'por confirmar';\n  const texto     = `Estimado(a) ${paciente.nombre}, le recordamos su cita de ${servicio.nombre} programada para el ${fechaTxt} a las ${horaTxt}. Costo estimado: ${costoTxt}. Responda este mensaje si necesita reagendar.`;\n\n  resultados.push({ json: {\n    cita_id:          cita.id,\n    clinica_id:       cita.clinica_id,\n    cuenta_id:        clinica.cuenta_id,\n    channel:          paciente.channel,\n    channel_user_id:  paciente.channel_user_id,\n    bot_token:        canal.config.bot_token,\n    texto_recordatorio: texto\n  }});\n}\n\nreturn resultados;\n"
      },
      "id": "node-unir-y-filtrar",
      "name": "Unir datos y filtrar recordatorios",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1680, 300]
