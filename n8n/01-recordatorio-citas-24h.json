{
  "name": "01 Recordatorio de Citas 24h",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 15 }]
        }
      },
      "id": "node-schedule",
      "name": "Disparador cada 15 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://vbsoujyosifqtazcidul.supabase.co/rest/v1/appointments",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "select", "value": "id,fecha_hora,costo,status,patient_id,service_id,patients(nombre,channel,channel_user_id),services(nombre)" },
            { "name": "status", "value": "in.(programada,confirmada)" },
            { "name": "recordatorio_enviado_at", "value": "is.null" }
          ]
        }
      },
      "id": "node-buscar-citas",
      "name": "Buscar citas sin recordatorio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "credentials": {
        "supabaseApi": {
          "id": "cred-supabase",
          "name": "Supabase — Clinica Dental"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const citas = Array.isArray($input.first().json) ? $input.first().json : [];\nconst ahora = Date.now();\nconst min = ahora + 23 * 3600000;\nconst max = ahora + 25 * 3600000;\n\nconst enVentana = citas.filter(c => {\n  // Normalizar formato Supabase '2026-05-21 15:10:36+00' a ISO 8601 valido\n  const iso = c.fecha_hora.replace(' ', 'T').replace(/\\+(\\d{2})$/, '+$1:00');\n  const t = new Date(iso).getTime();\n  return t >= min && t <= max;\n});\n\nreturn enVentana.map(c => ({ json: c }));\n"
      },
      "id": "node-filtrar-ventana",
      "name": "Filtrar ventana 23-25h",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-hay",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-if-hay",
      "name": "Hay citas en ventana?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": { "batchSize": 1, "options": {} },
      "id": "node-split",
      "name": "Iterar por cita",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1120, 220]
    },
    {
      "parameters": {
        "jsCode": "const cita = $input.first().json;\nconst paciente = cita.patients;\nconst servicio = cita.services;\n\nconst fecha = new Date(cita.fecha_hora);\nconst opsFecha = { timeZone: 'America/Mexico_City', weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };\nconst opsHora = { timeZone: 'America/Mexico_City', hour: '2-digit', minute: '2-digit', hour12: true };\nconst fechaTxt = fecha.toLocaleDateString('es-MX', opsFecha);\nconst horaTxt = fecha.toLocaleTimeString('es-MX', opsHora);\nconst costoTxt = cita.costo ? `$${Number(cita.costo).toLocaleString('es-MX', { minimumFractionDigits: 2 })} MXN` : 'por confirmar';\n\nconst texto = `Estimado(a) ${paciente.nombre}, le recordamos su cita de ${servicio.nombre} programada para el ${fechaTxt} a las ${horaTxt}. Costo estimado: ${costoTxt}. Responda este mensaje si necesita reagendar.`;\n\nreturn [{\n  json: {\n    id: cita.id,\n    channel: paciente.channel,\n    channel_user_id: paciente.channel_user_id,\n    texto_recordatorio: texto\n  }\n}];\n"
      },
      "id": "node-construir-texto",
      "name": "Construir texto del recordatorio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 220]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [{ "id": "c1", "leftValue": "={{ $json.channel }}", "rightValue": "telegram", "operator": { "type": "string", "operation": "equals" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "telegram"
            },
            {
              "conditions": {
                "conditions": [{ "id": "c2", "leftValue": "={{ $json.channel }}", "rightValue": "whatsapp", "operator": { "type": "string", "operation": "equals" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "whatsapp"
            }
          ]
        },
        "options": {}
      },
      "id": "node-switch-canal",
      "name": "Switch por canal",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1560, 220]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.channel_user_id }}",
        "text": "={{ $json.texto_recordatorio }}",
        "additionalFields": {}
      },
      "id": "node-telegram-send",
      "name": "Telegram: enviar recordatorio",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1780, 160],
      "continueOnFail": true,
      "credentials": {
        "telegramApi": {
          "id": "cred-telegram",
          "name": "Telegram Bot — Clinica Dental"
        }
      }
    },
    {
      "parameters": {},
      "id": "node-whatsapp-noop",
      "name": "WhatsApp (pendiente)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1780, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ 'https://vbsoujyosifqtazcidul.supabase.co/rest/v1/appointments?id=eq.' + $('Construir texto del recordatorio').first().json.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ recordatorio_enviado_at: new Date().toISOString() }) }}"
      },
      "id": "node-marcar-enviado",
      "name": "Marcar recordatorio enviado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 160],
      "continueOnFail": true,
      "credentials": {
        "supabaseApi": {
          "id": "cred-supabase",
          "name": "Supabase — Clinica Dental"
        }
      }
    },
    {
      "parameters": {
        "content": "WhatsApp: conectar Cloud API aqui.\nUsar channel_user_id como wa_id.",
        "height": 80,
        "width": 240
      },
      "id": "node-sticky-wa",
      "name": "Nota WhatsApp",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [1780, 400]
    }
  ],
  "connections": {
    "Disparador cada 15 minutos": {
      "main": [[{ "node": "Buscar citas sin recordatorio", "type": "main", "index": 0 }]]
    },
    "Buscar citas sin recordatorio": {
      "main": [[{ "node": "Filtrar ventana 23-25h", "type": "main", "index": 0 }]]
    },
    "Filtrar ventana 23-25h": {
      "main": [[{ "node": "Hay citas en ventana?", "type": "main", "index": 0 }]]
    },
    "Hay citas en ventana?": {
      "main": [[{ "node": "Iterar por cita", "type": "main", "index": 0 }]]
    },
    "Iterar por cita": {
      "main": [[{ "node": "Construir texto del recordatorio", "type": "main", "index": 0 }]]
    },
    "Construir texto del recordatorio": {
      "main": [[{ "node": "Switch por canal", "type": "main", "index": 0 }]]
    },
    "Switch por canal": {
      "main": [
        [{ "node": "Telegram: enviar recordatorio", "type": "main", "index": 0 }],
        [{ "node": "WhatsApp (pendiente)", "type": "main", "index": 0 }]
      ]
    },
    "Telegram: enviar recordatorio": {
      "main": [[{ "node": "Marcar recordatorio enviado", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Mexico_City",
    "saveManualExecutions": true
  },
  "staticData": null,
  "meta": { "templateCredsSetupCompleted": false },
  "pinData": {},
  "versionId": "01-v4",
  "triggerCount": 0,
  "tags": []
}
