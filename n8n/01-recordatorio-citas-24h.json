      "id": "b0a0baae-bcde-43ec-b9a1-007ea33946ad",
      "name": "Buscar citas sin recordatorio (todas las clinicas)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1232, 80],
      "credentials": {
        "supabaseApi": { "id": "tkYN9T844RX9s9K8", "name": "Supabase — Clinica Dental" }
      }
    },
    {
      "parameters": {
        "jsCode": "const todos = $input.all();\nlet citas = [];\nif (todos.length === 1 && Array.isArray(todos[0].json)) {\n  citas = todos[0].json;\n} else {\n  citas = todos.map(i => i.json).filter(v => v && typeof v === 'object' && !Array.isArray(v));\n}\n\nconst ahora = Date.now();\nconst min = ahora + 23 * 3600000;\nconst max = ahora + 25 * 3600000;\n\nconst enVentana = citas.filter(c => {\n  if (!c.clinicas || c.clinicas.activa === false) return false;\n  const iso = (c.fecha_hora || '').replace(' ', 'T').replace(/\\+(\\d{2})$/, '+$1:00');\n  const t = new Date(iso).getTime();\n  return !isNaN(t) && t >= min && t <= max;\n});\n\nreturn enVentana.map(c => ({ json: c }));"
      },
      "id": "b172c067-0593-4ce4-abe3-6a2f522cec75",
      "name": "Filtrar ventana 23-25h",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1008, 80]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 },
          "conditions": [
            {
              "id": "cond-hay",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "3ac76e74-1c32-46c3-a1d9-ed3be80958da",
      "name": "Hay citas en ventana?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-800, 80]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const cita = $input.item.json;\nconst paciente = cita.patients;\nconst servicio = cita.services;\nconst cuentaId = cita.clinicas ? cita.clinicas.cuenta_id : null;\n\nconst isoFecha = (cita.fecha_hora || '').replace(' ', 'T').replace(/\\+(\\d{2})$/, '+$1:00');\nconst fecha = new Date(isoFecha);\n\nconst opsFecha = { timeZone: 'America/Mexico_City', weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };\nconst opsHora  = { timeZone: 'America/Mexico_City', hour: '2-digit', minute: '2-digit', hour12: true };\nconst fechaTxt = fecha.toLocaleDateString('es-MX', opsFecha);\nconst horaTxt  = fecha.toLocaleTimeString('es-MX', opsHora);\n\nconst texto = 'Estimado(a) ' + paciente.nombre + ', le recordamos su cita de ' + servicio.nombre + ' programada para el ' + fechaTxt + ' a las ' + horaTxt + '.';\n\nreturn {\n  json: {\n    id:                 cita.id,\n    clinica_id:         cita.clinica_id,\n    cuenta_id:          cuentaId,\n    channel:            paciente.channel,\n    channel_user_id:    paciente.channel_user_id,\n    texto_recordatorio: texto\n  }\n};"
      },
