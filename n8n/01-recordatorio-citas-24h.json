    {
      "parameters": {
        "jsCode": "// ============================================================\n// CONFIGURACION POR CLINICA\n// Al importar para una nueva clinica, reemplaza ambos UUIDs.\n// clinica_id: ID de la clinica en la tabla clinicas.\n// cuenta_id:  ID de la cuenta (tabla cuentas) — necesario para uso_metering.\n// ============================================================\nconst clinica_id = 'REEMPLAZAR_CON_UUID_DE_CLINICA';\nconst cuenta_id  = 'REEMPLAZAR_CON_UUID_DE_CUENTA';\nreturn [{ json: { clinica_id, cuenta_id } }];\n"
      },
      "id": "node-contexto-clinica",
      "name": "Contexto de clinica",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [368, 1200]
    },
    {
      "parameters": {
        "url": "https://vbsoujyosifqtazcidul.supabase.co/rest/v1/appointments",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "select",
              "value": "id,fecha_hora,costo,status,clinica_id,patient_id,service_id,patients(nombre,channel,channel_user_id),services(nombre)"
            },
            {
              "name": "clinica_id",
              "value": "={{ 'eq.' + $('Contexto de clinica').first().json.clinica_id }}"
            },
            {
              "name": "status",
              "value": "in.(programada,confirmada)"
            },
            {
              "name": "recordatorio_enviado_at",
              "value": "is.null"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "92c67b06-0c4a-45e1-a41d-52ebab24bcb4",
      "name": "Buscar citas sin recordatorio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [592, 1392],
      "credentials": {
        "supabaseApi": {
          "id": "tkYN9T844RX9s9K8",
          "name": "Supabase — Clinica Dental"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const todos = $input.all();\nlet citas = [];\nif (todos.length === 1 && Array.isArray(todos[0].json)) {\n  citas = todos[0].json;\n} else {\n  citas = todos.map(i => i.json).filter(v => v && typeof v === 'object' && !Array.isArray(v));\n}\n\nconst ahora = Date.now();\nconst min = ahora + 23 * 3600000;\nconst max = ahora + 25 * 3600000;\n\nconst enVentana = citas.filter(c => {\n  const iso = (c.fecha_hora || '').replace(' ', 'T').replace(/\\+(\\d{2})$/, '+$1:00');\n  const t = new Date(iso).getTime();\n  return !isNaN(t) && t >= min && t <= max;\n});\n\nreturn enVentana.map(c => ({ json: c }));"
      },
      "id": "2bda3542-bd6b-4f3c-8865-a3e4400e7c4d",
      "name": "Filtrar ventana 23-25h",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [816, 1392]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-hay",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e01d2010-1ae7-49bd-aa7e-710fd3540a74",
      "name": "Hay citas en ventana?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1024, 1392]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const cita = $input.item.json;\nconst paciente = cita.patients;\nconst servicio = cita.services;\nconst ctx = $('Contexto de clinica').first().json;\n\nconst isoFecha = (cita.fecha_hora || '').replace(' ', 'T').replace(/\\+(\\d{2})$/, '+$1:00');\nconst fecha = new Date(isoFecha);\n\nconst opsFecha = { timeZone: 'America/Mexico_City', weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };\nconst opsHora  = { timeZone: 'America/Mexico_City', hour: '2-digit', minute: '2-digit', hour12: true };\nconst fechaTxt = fecha.toLocaleDateString('es-MX', opsFecha);\nconst horaTxt  = fecha.toLocaleTimeString('es-MX', opsHora);\n\nconst texto = 'Estimado(a) ' + paciente.nombre + ', le recordamos su cita de ' + servicio.nombre + ' programada para el ' + fechaTxt + ' a las ' + horaTxt + '.';\n\nreturn {\n  json: {\n    id:                 cita.id,\n    clinica_id:         cita.clinica_id || ctx.clinica_id,\n    cuenta_id:          ctx.cuenta_id,\n    channel:            paciente.channel,\n    channel_user_id:    paciente.channel_user_id,\n    texto_recordatorio: texto\n  }\n};"
      },
      "id": "da5a1c93-a170-46d2-8d31-f0f88a4478bf",
      "name": "Construir texto del recordatorio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
