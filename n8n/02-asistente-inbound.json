    {
      "parameters": {
        "jsCode": "// Telegram envia cada update por POST. El secret_token viaja en el header\n// X-Telegram-Bot-Api-Secret-Token y nos dice de que clinica es el bot.\nconst item = $input.first().json;\nconst body = item.body || {};\nconst headers = item.headers || {};\nconst secret = headers['x-telegram-bot-api-secret-token'] || '';\nconst msg = body.message || {};\nconst chatId = String(msg.chat && msg.chat.id ? msg.chat.id : '');\nconst texto = msg.text || '';\nconst nombre = [msg.from && msg.from.first_name, msg.from && msg.from.last_name].filter(Boolean).join(' ') || 'Paciente';\nreturn [{ json: { secret_token: secret, chat_id: chatId, texto_entrante: texto, nombre_paciente: nombre } }];\n"
      },
      "id": "11110000-aaaa-4000-9000-000000000002",
      "name": "Extraer mensaje y secret",
      "type": "n8n-nodes-base.code",
