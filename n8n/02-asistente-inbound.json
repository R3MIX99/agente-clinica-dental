              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-haiku-4-5-20251001\",\n  \"max_tokens\": 512,\n  \"system\": {{ JSON.stringify($json.system_prompt) }},\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.mensaje_usuario) }}\n    }\n  ]\n}"
      },
      "id": "node-claude-api",
      "name": "Claude API (Haiku)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2880, 260]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Construir system prompt').first().json;\nconst respuestaAPI = $input.first().json;\n\nlet parsed = { tipo: 'respuesta', texto: 'En este momento no puedo procesar su solicitud. Por favor, intente de nuevo o llame al telefono de la clinica.' };\n\ntry {\n  const contenido = respuestaAPI.content[0].text;\n  const jsonMatch = contenido.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    parsed = JSON.parse(jsonMatch[0]);\n  }\n} catch (e) {\n  // Si falla el parseo, usar respuesta de fallback\n}\n\nreturn [{\n  json: {\n    ...ctx,\n    tipo_respuesta: parsed.tipo,\n    texto_respuesta: parsed.texto\n  }\n}];\n"
      },
      "id": "node-parsear-respuesta",
      "name": "Parsear respuesta de Claude",
      "type": "n8n-nodes-base.code",
