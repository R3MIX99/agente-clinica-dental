    {
      "parameters": {
        "jsCode": "const message = $input.first().json.message;\nconst chatId = String(message.chat.id);\nconst texto = message.text || '';\nconst nombre = [message.from.first_name, message.from.last_name].filter(Boolean).join(' ') || 'Paciente';\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    texto_entrante: texto,\n    nombre_paciente: nombre\n  }\n}];\n"
      },
