{
  "name": "02 Asistente Inbound",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "node-tg-trigger",
      "name": "Telegram: mensaje entrante",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "telegram-inbound-dental",
      "credentials": {
        "telegramApi": {
          "id": "cred-telegram",
          "name": "Telegram Bot — Clinica Dental"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// ============================================================\n// CONFIGURACION POR CLINICA\n// Al importar este workflow, reemplaza el UUID de abajo\n// con el ID real de la clinica en Supabase.\n// Tambien asegura que la credencial Telegram apunta al bot\n// correcto para esta clinica.\n// ============================================================\nconst clinica_id = 'REEMPLAZAR_CON_UUID_DE_CLINICA';\n\nconst msg = $input.first().json.message;\nconst chatId = String(msg.chat.id);\nconst texto = msg.text || '';\nconst nombre = [msg.from?.first_name, msg.from?.last_name].filter(Boolean).join(' ') || 'Paciente';\n\nreturn [{ json: { chat_id: chatId, texto_entrante: texto, nombre_paciente: nombre, clinica_id } }];\n"
      },
      "id": "node-extraer",
      "name": "Extraer datos del mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://vbsoujyosifqtazcidul.supabase.co/rest/v1/patients",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "resolution=merge-duplicates,return=representation" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "on_conflict", "value": "channel,channel_user_id" }
          ]
        },
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ JSON.stringify({ nombre: $json.nombre_paciente, channel: 'telegram', channel_user_id: $json.chat_id, clinica_id: $json.clinica_id }) }}"
      },
      "id": "node-upsert-paciente",
      "name": "Upsert paciente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300],
      "credentials": {
        "supabaseApi": {
          "id": "cred-supabase",
          "name": "Supabase — Clinica Dental"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const paciente = $input.first().json;\nconst arr = Array.isArray(paciente) ? paciente : [paciente];\nconst p = arr[0];\nconst datos = $('Extraer datos del mensaje').first().json;\nreturn [{ json: { paciente_id: p.id, chat_id: datos.chat_id, texto_entrante: datos.texto_entrante, nombre_paciente: p.nombre, clinica_id: datos.clinica_id } }];\n"
      },
      "id": "node-extraer-paciente",
      "name": "Extraer id del paciente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://vbsoujyosifqtazcidul.supabase.co/rest/v1/conversations",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "patient_id", "value": "eq.{{ $json.paciente_id }}" },
            { "name": "clinica_id", "value": "eq.{{ $json.clinica_id }}" },
            { "name": "status", "value": "neq.cerrada" },
            { "name": "order", "value": "created_at.desc" },
            { "name": "limit", "value": "1" }
          ]
        }
      },
      "id": "node-buscar-conv",
      "name": "Buscar conversacion abierta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 300],
      "credentials": {
        "supabaseApi": {
          "id": "cred-supabase",
          "name": "Supabase — Clinica Dental"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const convs = Array.isArray($input.first().json) ? $input.first().json : [];\nconst ctx = $('Extraer id del paciente').first().json;\nconst conv = convs[0] || null;\nreturn [{\n  json: {\n    ...ctx,\n    conversacion_id: conv ? conv.id : null,\n    mode_actual: conv ? conv.mode : 'bot',\n    es_nueva: conv === null\n  }\n}];\n"
      },
      "id": "node-resolver-conv",
      "name": "Resolver conversacion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [{ "id": "c-nueva", "leftValue": "={{ $json.es_nueva }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }],
          "combinator": "and"
        }
      },
      "id": "node-if-nueva",
      "name": "Es nueva conversacion?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://vbsoujyosifqtazcidul.supabase.co/rest/v1/conversations",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=representation" }
          ]
        },
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ JSON.stringify({ patient_id: $json.paciente_id, clinica_id: $json.clinica_id, channel: 'telegram', mode: 'bot', status: 'abierta' }) }}"
      },
      "id": "node-crear-conv",
      "name": "Crear nueva conversacion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1920, 180],
      "credentials": {
        "supabaseApi": {
          "id": "cred-supabase",
          "name": "Supabase — Clinica Dental"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Resolver conversacion').first().json;\nlet convId = ctx.conversacion_id;\nif (ctx.es_nueva) {\n  const nueva = $input.first().json;\n  const arr = Array.isArray(nueva) ? nueva : [nueva];\n  convId = arr[0]?.id || convId;\n}\nreturn [{ json: { ...ctx, conversacion_id: convId, mode_actual: ctx.es_nueva ? 'bot' : ctx.mode_actual } }];\n"
      },
      "id": "node-asignar-conv",
      "name": "Asignar id conversacion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2160, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://vbsoujyosifqtazcidul.supabase.co/rest/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=representation" }
          ]
        },
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ JSON.stringify({ conversation_id: $json.conversacion_id, direction: 'entrante', sender: 'paciente', contenido: $json.texto_entrante }) }}"
      },
      "id": "node-insertar-msg-entrante",
      "name": "Insertar mensaje entrante",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2400, 300],
      "credentials": {
        "supabaseApi": {
          "id": "cred-supabase",
          "name": "Supabase — Clinica Dental"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [{ "id": "c-bot", "leftValue": "={{ $('Asignar id conversacion').first().json.mode_actual }}", "rightValue": "bot", "operator": { "type": "string", "operation": "equals" } }],
          "combinator": "and"
        }
      },
      "id": "node-if-bot",
      "name": "Modo bot?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2640, 300]
    },
    {
      "parameters": {},
      "id": "node-noop-humano",
