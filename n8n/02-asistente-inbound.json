        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ JSON.stringify({ p_clinica_id: $('Asignar id conversacion').first().json.clinica_id }) }}"
      },
      "id": "node-verificar-saldo",
      "name": "Verificar saldo IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2880, 160],
      "credentials": {
        "supabaseApi": {
          "id": "cred-supabase",
          "name": "Supabase — Clinica Dental"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [{ "id": "c-saldo", "leftValue": "={{ $json.disponible }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }],
          "combinator": "and"
        }
      },
      "id": "node-if-saldo",
      "name": "Saldo IA disponible?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [3120, 160]
    },
    {
      "parameters": {
        "jsCode": "// Sin saldo: derivar a humano e informar al paciente\nconst ctx = $('Asignar id conversacion').first().json;\nreturn [{ json: { ...ctx, tipo_respuesta: 'handoff', texto_respuesta: 'En este momento el asistente automatico no esta disponible. Un agente de la clinica le atendera en breve. Disculpe los inconvenientes.' } }];\n"
      },
      "id": "node-handoff-saldo",
      "name": "Handoff por saldo agotado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3360, 60]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "https://vbsoujyosifqtazcidul.supabase.co/rest/v1/conversations",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "id", "value": "eq.{{ $json.conversacion_id }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ JSON.stringify({ mode: 'humano', status: 'pendiente', intencion: 'saldo_ia_agotado' }) }}"
      },
      "id": "node-conv-saldo-humano",
      "name": "Cambiar conv a humano (saldo)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3600, 60],
      "credentials": {
        "supabaseApi": {
          "id": "cred-supabase",
          "name": "Supabase — Clinica Dental"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Handoff por saldo agotado').first().json.chat_id }}",
        "text": "={{ $('Handoff por saldo agotado').first().json.texto_respuesta }}",
        "additionalFields": {}
      },
      "id": "node-tg-saldo-agotado",
      "name": "Telegram: aviso saldo agotado",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [3840, 60],
      "credentials": {
        "telegramApi": {
          "id": "cred-telegram",
          "name": "Telegram Bot — Clinica Dental"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://vbsoujyosifqtazcidul.supabase.co/rest/v1/clinicas",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Accept", "value": "application/json" }]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "id", "value": "eq.{{ $('Asignar id conversacion').first().json.clinica_id }}" },
            { "name": "select", "value": "nombre,direccion,telefono,email,sitio_web,horario,formas_pago,facturacion,faq" },
            { "name": "limit", "value": "1" }
          ]
        }
      },
      "id": "node-clinica",
      "name": "Leer datos de la clinica",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3360, 240],
      "credentials": {
        "supabaseApi": {
          "id": "cred-supabase",
          "name": "Supabase — Clinica Dental"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://vbsoujyosifqtazcidul.supabase.co/rest/v1/services",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Accept", "value": "application/json" }]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "clinica_id", "value": "eq.{{ $('Asignar id conversacion').first().json.clinica_id }}" },
            { "name": "activo", "value": "eq.true" },
            { "name": "select", "value": "nombre,descripcion,precio,duracion_min" }
          ]
        }
      },
      "id": "node-servicios",
      "name": "Leer servicios activos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3600, 240],
      "credentials": {
        "supabaseApi": {
          "id": "cred-supabase",
          "name": "Supabase — Clinica Dental"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Asignar id conversacion').first().json;\nconst clinicaArr = $('Leer datos de la clinica').first().json;\nconst serviciosArr = $('Leer servicios activos').first().json;\n\nconst clinica = Array.isArray(clinicaArr) ? clinicaArr[0] : clinicaArr;\nconst servicios = Array.isArray(serviciosArr) ? serviciosArr : [];\n\nconst faqTexto = Array.isArray(clinica.faq)\n  ? clinica.faq.map(f => `P: ${f.pregunta}\\nR: ${f.respuesta}`).join('\\n\\n')\n  : '';\n\nconst serviciosTxt = servicios\n  .map(s => `- ${s.nombre}: $${Number(s.precio).toLocaleString('es-MX')} MXN (${s.duracion_min} min). ${s.descripcion || ''}`)\n  .join('\\n');\n\nconst systemPrompt = `Eres el asistente virtual de ${clinica.nombre}.\\n\\nDatos de la clinica:\\n- Direccion: ${clinica.direccion}\\n- Telefono: ${clinica.telefono}\\n- Correo: ${clinica.email}\\n- Sitio web: ${clinica.sitio_web}\\n- Horario: ${clinica.horario}\\n- Formas de pago: ${clinica.formas_pago}\\n- Facturacion: ${clinica.facturacion}\\n\\nServicios:\\n${serviciosTxt}\\n\\nPreguntas frecuentes:\\n${faqTexto}\\n\\nInstrucciones:\\n1. Responde unicamente sobre la clinica, servicios, citas, horarios, contacto, facturacion y formas de pago.\\n2. Si el paciente pide hablar con una persona, se queja o pregunta algo fuera de alcance, usa tipo handoff.\\n3. Responde en espanol formal, sin emojis.\\n4. Devuelve EXCLUSIVAMENTE un JSON con esta estructura exacta (sin texto fuera del JSON):\\n   {\\\"tipo\\\": \\\"respuesta\\\" | \\\"handoff\\\", \\\"texto\\\": \\\"tu respuesta\\\", \\\"intencion\\\": \\\"consulta_precio | agenda_cita | consulta_horario | consulta_contacto | faq | queja | otro\\\", \\\"sentimiento\\\": \\\"positivo | neutral | negativo\\\"}`;\n\nreturn [{ json: { ...ctx, system_prompt: systemPrompt } }];\n"
      },
      "id": "node-prompt",
      "name": "Construir system prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3840, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-haiku-4-5-20251001', max_tokens: 512, system: $json.system_prompt, messages: [{ role: 'user', content: $json.texto_entrante }] }) }}"
      },
      "id": "node-claude",
      "name": "Claude API (Haiku)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [4080, 240],
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred-anthropic-header",
          "name": "Anthropic API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Construir system prompt').first().json;\nconst resp = $input.first().json;\n\nconst txt = resp.text || resp.content?.[0]?.text || '';\nconst tokensEntrada = resp.usage?.input_tokens || 0;\nconst tokensSalida  = resp.usage?.output_tokens || 0;\n\nlet parsed = { tipo: 'respuesta', texto: 'En este momento no puedo procesar su solicitud. Por favor llame al telefono de la clinica.', intencion: 'error', sentimiento: 'neutral' };\ntry {\n  const match = txt.match(/\\{[\\s\\S]*\\}/);\n  if (match) parsed = JSON.parse(match[0]);\n} catch (_) {}\n\nreturn [{ json: { ...ctx, tipo_respuesta: parsed.tipo, texto_respuesta: parsed.texto, intencion: parsed.intencion || 'otro', sentimiento: parsed.sentimiento || 'neutral', tokens_entrada: tokensEntrada, tokens_salida: tokensSalida } }];\n"
      },
      "id": "node-parsear",
      "name": "Parsear respuesta de Claude",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [4320, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://vbsoujyosifqtazcidul.supabase.co/rest/v1/rpc/registrar_consumo_ia",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ JSON.stringify({ p_clinica_id: $json.clinica_id, p_conversacion_id: $json.conversacion_id, p_tokens_entrada: $json.tokens_entrada, p_tokens_salida: $json.tokens_salida, p_modelo: 'claude-haiku-4-5-20251001' }) }}",
        "options": { "ignore4xxStatusCode": true }
      },
      "id": "node-registrar-consumo",
      "name": "Registrar consumo IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [4560, 240],
