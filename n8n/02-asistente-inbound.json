        "conditions": {
          "conditions": [{ "id": "c-hoff", "leftValue": "={{ $('Parsear respuesta de Claude').first().json.tipo_respuesta }}", "rightValue": "handoff", "operator": { "type": "string", "operation": "equals" } }],
          "combinator": "and"
        }
      },
      "id": "node-if-handoff",
      "name": "Es handoff?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [5040, 240]
    },
    {
      "parameters": {
