    {
      "parameters": {
        "jsCode": "const paciente = $('Upsert paciente en Supabase').first().json[0];\nconst conversaciones = $input.first().json;\nconst datosMensaje = $('Extraer datos del mensaje').first().json;\n\nreturn [{\n  json: {\n    paciente_id: paciente.id,\n    chat_id: datosMensaje.chat_id,\n    texto_entrante: datosMensaje.texto_entrante,\n    nombre_paciente: paciente.nombre,\n    conversaciones_existentes: conversaciones\n  }\n}];\n"
      },
      "id": "node-combinar-contexto",
      "name": "Combinar contexto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $input.first().json;\nconst convs = ctx.conversaciones_existentes;\n\nlet conversacionId = null;\nlet modeActual = 'bot';\n\nif (Array.isArray(convs) && convs.length > 0) {\n  conversacionId = convs[0].id;\n  modeActual = convs[0].mode;\n}\n\nreturn [{\n  json: {\n    ...ctx,\n    conversacion_id: conversacionId,\n    mode_actual: modeActual,\n    es_nueva_conversacion: conversacionId === null\n  }\n}];\n"
      },
