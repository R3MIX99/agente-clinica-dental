      "parameters": {
        "jsCode": "// ============================================================\n// CONFIGURACION POR CLINICA\n// Al importar este workflow para una nueva clinica, reemplaza\n// el UUID de abajo con el ID real de esa clinica en Supabase.\n// Tambien asegura que la credencial Telegram apunte al bot\n// correcto para esta clinica.\n// ============================================================\nconst clinica_id = 'REEMPLAZAR_CON_UUID_DE_CLINICA';\n\nconst msg = $input.first().json.message;\nconst chatId = String(msg.chat.id);\nconst texto = msg.text || '';\nconst nombre = [msg.from?.first_name, msg.from?.last_name].filter(Boolean).join(' ') || 'Paciente';\nreturn [{ json: { chat_id: chatId, texto_entrante: texto, nombre_paciente: nombre, clinica_id } }];\n"
