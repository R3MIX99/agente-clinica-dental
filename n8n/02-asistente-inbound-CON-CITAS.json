    "jsCode": "// Combina el mensaje con la clinica resuelta por el secret_token.\n// Si el secret no corresponde a un canal activo, se detiene (no responde).\nconst ctx = $('Extraer mensaje y secret').first().json;\nconst arr = $input.first().json;\nconst row = Array.isArray(arr) ? arr[0] : arr;\nif (!row || !row.bot_token || row.activo === false) {\n  return [];\n}\nreturn [{ json: { ...ctx, clinica_id: row.clinica_id, cuenta_id: row.cuenta_id, bot_token: row.bot_token } }];\n"
   },
