   "id": "a8c81280-18c4-4052-af21-eaa15d0455dc",
   "name": "Leer servicios activos",
   "credentials": {
    "supabaseApi": {
     "id": "tkYN9T844RX9s9K8",
     "name": "Supabase — Clinica Dental"
    }
