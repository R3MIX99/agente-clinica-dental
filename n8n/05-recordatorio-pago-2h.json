      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-352, 0],
      "credentials": {
        "supabaseApi": { "id": "tkYN9T844RX9s9K8", "name": "Supabase — Clinica Dental" }
      }
    },
    {
