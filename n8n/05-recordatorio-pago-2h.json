            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 },
                "conditions": [
                  {
                    "id": "c1",
                    "leftValue": "={{ $('Construir mensaje de pago').item.json.channel }}",
                    "operator": { "type": "string", "operation": "equals" },
                    "rightValue": "telegram"
                  }
