{
  "name": "05 Recordatorio de Pago 2h",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "minutes", "minutesInterval": 15 } ] }
      },
      "id": "aa000000-0000-4000-9000-000000000001",
      "name": "Disparador cada 15 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-1456, 80]
    },
    {
      "parameters": {
        "url": "https://vbsoujyosifqtazcidul.supabase.co/rest/v1/appointments",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "select", "value": "id,fecha_hora,costo,clinica_id,patient_id,status,estado_pago,pago_recordatorio_enviado_at,patients(nombre,channel,channel_user_id),services(nombre),clinicas(cuenta_id,datos_pago,activa)" },
            { "name": "status", "value": "eq.completada" },
            { "name": "estado_pago", "value": "eq.pendiente" },
            { "name": "pago_recordatorio_enviado_at", "value": "is.null" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Accept", "value": "application/json" } ] },
        "options": {}
      },
      "id": "aa000000-0000-4000-9000-000000000002",
      "name": "Buscar citas completadas sin pago",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1232, 80],
      "credentials": {
        "supabaseApi": { "id": "tkYN9T844RX9s9K8", "name": "Supabase — Clinica Dental" }
      }
    },
    {
      "parameters": {
        "jsCode": "const todos = $input.all();\nlet citas = [];\nif (todos.length === 1 && Array.isArray(todos[0].json)) {\n  citas = todos[0].json;\n} else {\n  citas = todos.map(i => i.json).filter(v => v && typeof v === 'object' && !Array.isArray(v));\n}\n\nconst ahora = Date.now();\nconst DOS_HORAS = 2 * 3600000;\n\nconst elegibles = citas.filter(c => {\n  if (!c.clinicas || c.clinicas.activa === false) return false;\n  if (!c.clinicas.datos_pago) return false;\n  if (!c.patients || !c.patients.channel_user_id) return false;\n  const iso = (c.fecha_hora || '').replace(' ', 'T').replace(/\\+(\\d{2})$/, '+$1:00');\n  const t = new Date(iso).getTime();\n  // Enviar solo cuando ya pasaron al menos 2 horas desde la cita\n  return !isNaN(t) && (ahora - t) >= DOS_HORAS;\n});\n\nreturn elegibles.map(c => ({ json: c }));"
      },
      "id": "aa000000-0000-4000-9000-000000000003",
      "name": "Filtrar elegibles (2h despues)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1008, 80]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 },
          "conditions": [
            {
              "id": "cond-hay",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "aa000000-0000-4000-9000-000000000004",
      "name": "Hay citas por cobrar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-800, 80]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const cita = $input.item.json;\nconst p = cita.patients;\nconst s = cita.services;\nconst c = cita.clinicas;\n\nconst monto = cita.costo != null\n  ? ' por un monto de $' + Number(cita.costo).toLocaleString('es-MX') + ' MXN'\n  : '';\n\nconst texto = 'Hola ' + p.nombre + ', su cita' + (s ? ' de ' + s.nombre : '') +\n  ' quedo pendiente de pago' + monto + '. Aqui estan los datos para realizar su pago:\\n\\n' +\n  (c.datos_pago || '') +\n  '\\n\\nUna vez realizado el pago, por favor envienos su comprobante. Gracias.';\n\nreturn {\n  json: {\n    id:              cita.id,\n    clinica_id:      cita.clinica_id,\n    cuenta_id:       c.cuenta_id,\n    channel:         p.channel,\n    channel_user_id: p.channel_user_id,\n    texto_pago:      texto\n  }\n};"
      },
      "id": "aa000000-0000-4000-9000-000000000005",
      "name": "Construir mensaje de pago",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-576, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://vbsoujyosifqtazcidul.supabase.co/rest/v1/rpc/canal_telegram_por_clinica",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Content-Type", "value": "application/json" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_clinica_id: $json.clinica_id }) }}",
        "options": {}
      },
      "id": "aa000000-0000-4000-9000-000000000006",
