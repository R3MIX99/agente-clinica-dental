    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst headers = $input.first().json.headers;\n\nconst secretEsperado = $env.N8N_SHARED_SECRET;\nconst secretRecibido = headers['x-shared-secret'] || headers['X-Shared-Secret'] || '';\n\nconst esValido = secretRecibido === secretEsperado;\n\nreturn [{\n  json: {\n    es_valido: esValido,\n    conversacion_id: body.conversationId,\n    channel: body.channel,\n    channel_user_id: body.channelUserId,\n    texto: body.texto,\n    agente_id: body.agenteId\n  }\n}];\n"
      },
      "id": "node-validar-secreto",
      "name": "Validar secreto compartido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-secreto-valido",
              "leftValue": "={{ $json.es_valido }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-if-secreto",
      "name": "Secreto valido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
