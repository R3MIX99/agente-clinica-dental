{
  "name": "03 Respuesta de Agente Humano",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agente-mensaje",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook",
      "name": "Webhook: recibir mensaje del agente",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "agente-mensaje-dental"
    },
    {
      "parameters": {
        "jsCode": "// IMPORTANTE: define N8N_SHARED_SECRET en las variables de entorno de n8n.\n// El dashboard lee el mismo secreto desde la variable de entorno N8N_SHARED_SECRET.\n// NUNCA escribas el secreto en este archivo.\nconst SECRETO = $env.N8N_SHARED_SECRET || '';\n\nconst body    = $input.first().json.body || {};\nconst headers = $input.first().json.headers || {};\nconst secretRecibido = headers['x-shared-secret'] || headers['X-Shared-Secret'] || '';\n\n// El dashboard debe enviar siempre clinicaId para el aislamiento\nreturn [{\n  json: {\n    es_valido:        SECRETO !== '' && secretRecibido === SECRETO,\n    conversacion_id:  body.conversationId || '',\n    clinica_id:       body.clinicaId || '',\n    channel:          body.channel || 'telegram',\n    channel_user_id:  body.channelUserId || '',\n    texto:            body.texto || '',\n    agente_id:        body.agenteId || ''\n  }\n}];\n"
      },
      "id": "node-validar",
      "name": "Validar secreto y extraer body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [{ "id": "c-valido", "leftValue": "={{ $json.es_valido }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }],
          "combinator": "and"
        }
      },
      "id": "node-if-valido",
      "name": "Secreto valido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"error\": \"No autorizado\" }",
        "options": { "responseCode": 401 }
      },
      "id": "node-401",
      "name": "Responder 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [960, 480]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://vbsoujyosifqtazcidul.supabase.co/rest/v1/conversations",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Accept", "value": "application/json" }]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "id", "value": "eq.{{ $json.conversacion_id }}" },
            { "name": "clinica_id", "value": "eq.{{ $json.clinica_id }}" },
            { "name": "select", "value": "id,clinica_id,mode,status" },
            { "name": "limit", "value": "1" }
          ]
        }
      },
      "id": "node-verificar-conv",
      "name": "Verificar conversacion pertenece a clinica",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 180],
      "credentials": {
        "supabaseApi": {
          "id": "cred-supabase",
          "name": "Supabase — Clinica Dental"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const convArr = $input.first().json;\nconst arr = Array.isArray(convArr) ? convArr : [convArr];\nconst conv = arr[0];\nconst ctx = $('Validar secreto y extraer body').first().json;\n// La conversacion debe existir y pertenecer a esta clinica\nconst esValida = conv && conv.id && conv.clinica_id === ctx.clinica_id;\nreturn [{ json: { ...ctx, conv_valida: esValida } }];\n"
      },
      "id": "node-chequear-conv",
      "name": "Verificar aislamiento de clinica",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 180]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [{ "id": "c-conv", "leftValue": "={{ $json.conv_valida }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }],
          "combinator": "and"
        }
      },
      "id": "node-if-conv",
      "name": "Conversacion valida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1440, 180]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"error\": \"Conversacion no encontrada o no pertenece a esta clinica\" }",
        "options": { "responseCode": 403 }
      },
      "id": "node-403",
      "name": "Responder 403",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1680, 360]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://vbsoujyosifqtazcidul.supabase.co/rest/v1/clinic_channels",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Accept", "value": "application/json" }]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "clinica_id", "value": "eq.{{ $json.clinica_id }}" },
            { "name": "canal", "value": "eq.{{ $json.channel }}" },
            { "name": "activo", "value": "eq.true" },
            { "name": "select", "value": "config" },
            { "name": "limit", "value": "1" }
          ]
        }
      },
      "id": "node-obtener-canal",
      "name": "Obtener canal de la clinica",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1680, 120],
      "credentials": {
        "supabaseApi": {
          "id": "cred-supabase",
          "name": "Supabase — Clinica Dental"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const canalArr = $input.first().json;\nconst arr = Array.isArray(canalArr) ? canalArr : [canalArr];\nconst canal = arr[0];\nconst ctx = $('Verificar aislamiento de clinica').first().json;\nconst botToken = canal?.config?.bot_token || null;\nreturn [{ json: { ...ctx, bot_token: botToken, tiene_canal: botToken !== null } }];\n"
      },
      "id": "node-extraer-token",
      "name": "Extraer bot token de la clinica",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1920, 120]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [{ "id": "c-tg", "leftValue": "={{ $json.channel }}", "rightValue": "telegram", "operator": { "type": "string", "operation": "equals" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "telegram"
            },
            {
              "conditions": {
                "conditions": [{ "id": "c-wa", "leftValue": "={{ $json.channel }}", "rightValue": "whatsapp", "operator": { "type": "string", "operation": "equals" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "whatsapp"
            }
          ]
        },
        "options": {}
      },
      "id": "node-switch",
      "name": "Switch por canal",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [2160, 120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $json.bot_token }}/sendMessage",
        "sendHeaders": false,
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.channel_user_id, text: $json.texto }) }}"
      },
      "id": "node-tg-send",
      "name": "Telegram: enviar mensaje del agente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2400, 60],
      "continueOnFail": true
    },
    {
      "parameters": {},
      "id": "node-wa-noop",
      "name": "WhatsApp (pendiente)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [2400, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://vbsoujyosifqtazcidul.supabase.co/rest/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=representation" }
          ]
        },
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ JSON.stringify({ conversation_id: $('Extraer bot token de la clinica').first().json.conversacion_id, clinica_id: $('Extraer bot token de la clinica').first().json.clinica_id, direction: 'saliente', sender: 'agente', contenido: $('Extraer bot token de la clinica').first().json.texto, metadata: JSON.stringify({ agente_id: $('Extraer bot token de la clinica').first().json.agente_id }) }) }}"
      },
      "id": "node-insertar-msg",
      "name": "Insertar mensaje del agente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2640, 60],
      "continueOnFail": true,
      "credentials": {
        "supabaseApi": {
          "id": "cred-supabase",
          "name": "Supabase — Clinica Dental"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true }",
        "options": { "responseCode": 200 }
      },
      "id": "node-200",
      "name": "Responder 200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2880, 60]
    },
    {
      "parameters": {
        "content": "El secreto compartido se lee de la variable de entorno\nN8N_SHARED_SECRET — nunca esta en este JSON.\nConfigurar en: Settings > Variables de entorno.",
        "height": 80,
        "width": 320
      },
      "id": "node-sticky-secreto",
      "name": "Nota secreto compartido",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [240, 480]
    },
    {
      "parameters": {
        "content": "Aislamiento: se verifica que la conversacion\npertenezca a la clinicaId enviada en el body.\nSin este check, un agente podria responder\nen conversaciones de otra clinica.",
        "height": 100,
        "width": 300
      },
      "id": "node-sticky-aislamiento",
      "name": "Nota aislamiento",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [960, 560]
    },
    {
      "parameters": {
        "content": "WhatsApp: conectar Cloud API aqui.\nUsar channel_user_id como wa_id.\nEl bot_token no aplica para WhatsApp.",
        "height": 80,
        "width": 260
      },
      "id": "node-sticky-wa",
      "name": "Nota WhatsApp",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [2400, 360]
    }
  ],
  "connections": {
