        "jsCode": "// IMPORTANTE: cambia este valor por tu secreto real y usa el mismo en el dashboard (.env.local N8N_SHARED_SECRET)\nconst SECRETO = 'dental_2026_xK9mPqR';\n\nconst body = $input.first().json.body || {};\nconst headers = $input.first().json.headers || {};\nconst secretRecibido = headers['x-shared-secret'] || headers['X-Shared-Secret'] || '';\n\nreturn [{\n  json: {\n    es_valido:       secretRecibido === SECRETO,\n    conversacion_id: body.conversationId || '',\n    clinica_id:      body.clinicaId || '',\n    channel:         body.channel || 'telegram',\n    channel_user_id: body.channelUserId || '',\n    texto:           body.texto || '',\n    agente_id:       body.agenteId || ''\n  }\n}];\n"
      },
