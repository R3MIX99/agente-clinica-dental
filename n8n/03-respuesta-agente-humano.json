{
  "name": "03 Respuesta de Agente Humano",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agente-mensaje",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook",
      "name": "Webhook: recibir mensaje del agente",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "agente-mensaje-dental"
    },
    {
      "parameters": {
        "jsCode": "// IMPORTANTE: cambia este valor por tu secreto real y usa el mismo en el dashboard (.env.local N8N_SHARED_SECRET)\nconst SECRETO = 'CAMBIA_ESTE_SECRETO_POR_UNO_SEGURO';\n\nconst body = $input.first().json.body || {};\nconst headers = $input.first().json.headers || {};\nconst secretRecibido = headers['x-shared-secret'] || headers['X-Shared-Secret'] || '';\n\nreturn [{\n  json: {\n    es_valido: secretRecibido === SECRETO,\n    conversacion_id: body.conversationId || '',\n    channel: body.channel || 'telegram',\n    channel_user_id: body.channelUserId || '',\n    texto: body.texto || '',\n    agente_id: body.agenteId || ''\n  }\n}];\n"
      },
      "id": "node-validar",
      "name": "Validar secreto y extraer body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [{ "id": "c-valido", "leftValue": "={{ $json.es_valido }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }],
          "combinator": "and"
        }
      },
      "id": "node-if-valido",
      "name": "Secreto valido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"error\": \"No autorizado\" }",
        "options": { "responseCode": 401 }
      },
      "id": "node-401",
      "name": "Responder 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [900, 420]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [{ "id": "c-tg", "leftValue": "={{ $json.channel }}", "rightValue": "telegram", "operator": { "type": "string", "operation": "equals" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "telegram"
            },
            {
              "conditions": {
                "conditions": [{ "id": "c-wa", "leftValue": "={{ $json.channel }}", "rightValue": "whatsapp", "operator": { "type": "string", "operation": "equals" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "whatsapp"
            }
          ]
        },
        "options": {}
      },
      "id": "node-switch",
      "name": "Switch por canal",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [900, 260]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.channel_user_id }}",
        "text": "={{ $json.texto }}",
        "additionalFields": {}
      },
      "id": "node-tg-send",
      "name": "Telegram: enviar mensaje del agente",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1120, 160],
      "credentials": {
        "telegramApi": {
          "id": "cred-telegram",
          "name": "Telegram Bot — Clinica Dental"
        }
      }
    },
    {
      "parameters": {},
      "id": "node-wa-noop",
      "name": "WhatsApp (pendiente)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "content": "WhatsApp: conectar Cloud API aqui.\nUsar channel_user_id como wa_id.",
        "height": 70,
        "width": 220
      },
      "id": "node-sticky-wa",
      "name": "Nota WhatsApp",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [1120, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://vbsoujyosifqtazcidul.supabase.co/rest/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=representation" }
          ]
        },
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ JSON.stringify({ conversation_id: $('Validar secreto y extraer body').first().json.conversacion_id, direction: 'saliente', sender: 'agente', contenido: $('Validar secreto y extraer body').first().json.texto, metadata: JSON.stringify({ agente_id: $('Validar secreto y extraer body').first().json.agente_id }) }) }}"
      },
      "id": "node-insertar-msg",
      "name": "Insertar mensaje del agente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 200],
      "credentials": {
        "supabaseApi": {
          "id": "cred-supabase",
          "name": "Supabase — Clinica Dental"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true }",
        "options": { "responseCode": 200 }
      },
      "id": "node-200",
      "name": "Responder 200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1560, 200]
    }
  ],
