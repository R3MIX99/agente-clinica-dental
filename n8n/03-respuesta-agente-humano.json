      "parameters": {
        "jsCode": "const convData = $input.first().json;\nconst ctx = $('Validar secreto y extraer body').first().json;\n// clinica_id es obligatorio en el modelo multi-tenant\nif (!ctx.clinica_id) {\n  return [{ json: { ...ctx, conv_valida: false } }];\n}\nconst arr = Array.isArray(convData) ? convData : [convData];\nconst conv = arr[0];\nconst esValida = conv && conv.id && conv.clinica_id === ctx.clinica_id;\nreturn [{ json: { ...ctx, conv_valida: !!esValida } }];\n"
