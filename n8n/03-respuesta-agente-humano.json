            { "name": "limit",      "value": "1" }
          ]
        },
        "options": {}
      },
      "id": "node-verificar-conv",
      "name": "Verificar conversacion pertenece a clinica",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "alwaysOutputData": true,
      "position": [1008, 1280],
      "credentials": {
        "supabaseApi": {
          "id": "tkYN9T844RX9s9K8",
          "name": "Supabase — Clinica Dental"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const convData = $input.first().json;\nconst ctx = $('Validar secreto y extraer body').first().json;\n// Si clinica_id viene vacio, permitir paso (compatibilidad con dashboard sin actualizacion)\nif (!ctx.clinica_id) {\n  return [{ json: { ...ctx, conv_valida: true } }];\n}\nconst arr = Array.isArray(convData) ? convData : [convData];\nconst conv = arr[0];\nconst esValida = conv && conv.id && conv.clinica_id === ctx.clinica_id;\nreturn [{ json: { ...ctx, conv_valida: !!esValida } }];\n"
      },
